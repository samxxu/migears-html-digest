{
    "name": "migears/html-digest",
    "description": "A lightweight HTML text digest / summary extractor for PHP 8.1+",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\HtmlDigest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\HtmlDigest\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
